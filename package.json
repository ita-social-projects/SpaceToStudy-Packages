{
  "name": "space2study-packages",
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*",
    "packages/components/*"
  ],
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.4",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-onboarding": "^8.6.0",
    "@storybook/addon-webpack5-compiler-swc": "^2.1.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-webpack5": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "^3.1.1",
    "css-loader": "^7.1.2",
    "jsdom": "^26.1.0",
    "lerna": "^8.1.9",
    "sass-loader": "^16.0.4",
    "storybook": "^8.6.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^3.1.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "build:dev": "webpack --env mode=development",
    "build:prod": "webpack --env mode=production",
    "build": "webpack --env mode=production --stats detailed",
    "build-theme": "npm run build --prefix ./packages/theme"  ,
    "publish:major": "npx lerna version major",
    "publish:minor": "npx lerna version minor",
    "publish:patch": "npx lerna version patch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --coverage"
  }
